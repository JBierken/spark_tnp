{
    "efficiencies": [
        ["SAMatched", "StandAloneMuons"],
        ["SAMatched_fakerate", "StandAloneMuons"]
    ],
    "selection": "triggers==1 and  and tag_trigger_match==1 and tag_pt>8 and tag_isTight==1 and pair_opposite_charge==1 and tag_PFIso==1 and pair_mass_window==1",
    "definitions": {
        "triggers": "(HLT_Mu8_v==1) or (HLT_Mu15_v==1) or (HLT_Mu17_v==1) or (HLT_IsoMu24_v==1) or (HLT_Mu50_v==1)",
        "tag_hlt_mu8": "(tag_hltL3fL1sMu5L1f0L2f5L3Filtered8==1) and (tag_hltL3fL1sMu5L1f0L2f5L3Filtered8_dr < 0.1)",
        "tag_hlt_mu15": "(tag_hltL3fL1sMu15DQIqL1f0L2f10L3Filtered15==1) and (tag_hltL3fL1sMu15DQIqL1f0L2f10L3Filtered15_dr< 0.1)",
        "tag_hlt_mu17": "(tag_hltL3fL1sMu15DQIL1f0L2f10L3Filtered17==1) and (tag_hltL3fL1sMu15DQIL1f0L2f10L3Filtered17_dr < 0.1)",
        "tag_hlt_mu20": "(tag_hltL3fL1sMu18L1f0L2f10QL3Filtered20Q==1) and (tag_hltL3fL1sMu18L1f0L2f10QL3Filtered20Q_dr< 0.1)",
        "tag_hlt_isomu24": "(tag_hltL3fL1sSingleMu22L1f0L2f10QL3Filtered24Q==1) and (tag_hltL3fL1sSingleMu22L1f0L2f10QL3Filtered24Q_dr < 0.1)",
        "tag_hlt_mu50": "(tag_hltL3fL1sMu22Or25L1f10QL3Filtered50Q==1) and (tag_hltL3fL1sMu22Or25L1f10QL3Filtered50Q_dr < 0.1)",
        "tag_trigger_match": "(tag_hlt_mu8==1) or (tag_hlt_mu15==1) or (tag_hlt_mu17==1) or (tag_hlt_isomu24==1) or (tag_hlt_mu50==1)",
        "pair_opposite_charge": "(tag_charge * probe_charge = -1)",
        "pair_mass_window": "(pair_mass>=2.7) and (pair_mass<=3.5)",
        "isPositive":"(tag_pfIso04_neutral + tag_pfIso04_photon - tag_pfIso04_sumPU/2) > 0.0",
	    "tag_PFIso": "((isPositive==1 and (tag_pfIso04_charged + tag_pfIso04_neutral + tag_pfIso04_photon - tag_pfIso04_sumPU/2)/tag_pt < 0.15) or (isPositive==0 and (tag_pfIso04_charged /tag_pt) < 0.15))", 
        "SAMatched":"(probe_pt > 2) and (probe_isTrkMatch == 1) and (probe_isSA == 1)",
        "SAMatched_fakerate":"(probe_pt > 2) and (probeSA_isTrkMatch == 1) and (probe_isSA == 1)",
        "StandAloneMuons": "(probe_pt > 2) and (probe_isSA == 1)",
        "probe_abseta": "abs(probe_eta)"
    },
    "binning": {
        "pt": [3, 4, 5, 6, 7, 8, 9, 10, 30],
        "pt_onebin":[2,30],
        "abseta": [0, 0.9, 1.2, 2.1, 2.4],
        "eta": [-2.4, -2.1, -1.6, -1.2, -0.9, -0.3, -0.2, 0.2, 0.3, 0.9, 1.2, 1.6, 2.1, 2.4],
        "eta_onebin":[-1.6,1.6],
        "nvtx": [0,10, 15, 20, 25, 30, 35, 40, 45, 50, 55, 70],
        "mass": "np.linspace(2.80, 3.40, 50)",
        "mcMass": "np.linspace(2.80, 3.40, 50)",
        "phi":[-3.14, -2.5, -2.0, -1.25, -0.63, 0.0, 0.63, 1.25, 2.0, 2.5, 3.14]
    },
    "variables": {
        "pt": {"variable": "probe_pt", "pretty": "muon p_{T} (GeV)"},
        "eta": {"variable": "probe_eta", "pretty": "muon #eta"},
        "abseta": {"variable": "probe_abseta", "pretty": "|#eta|"},
        "pt_onebin": {"variable": "probe_pt", "pretty": "muon p_{T} (GeV)"},
        "eta_onebin": {"variable": "probe_eta", "pretty": "muon #eta"},
        "nvtx": {"variable": "nVertices", "pretty": "N(primary vertices)"},
        "phi":{"variable": "probe_phi", "pretty": "muon #phi"},
        "mass": {"variable": "pair_mass", "pretty": "m(#mu#mu) (GeV)"},
        "mcMass": {"variable": "pair_mass", "pretty": "m(#mu#mu) (GeV)"}
    },
    "fitVariable": "mass",
    "fitVariableGen": "mcMass",
    "binVariables": [
        ["pt","eta_onebin"],
        ["nvtx","eta_onebin","pt_onebin"],
        ["eta", "pt_onebin"],
        ["phi","pt_onebin","eta_onebin"]
    ],
    "shifts": {
    },
    "fitShifts": {
    }
}
